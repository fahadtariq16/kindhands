PORT=4000
# Public URL of the web app (used for links inside emails)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# PostgreSQL. Leave empty to use the embedded Postgres stored in PGLITE_DIR (local dev only).
DATABASE_URL=
PGLITE_DIR=./.data

# Email (production): set RESEND_API_KEY — sends over HTTPS, works on Render's free plan (which blocks SMTP ports).
RESEND_API_KEY=
# Or SMTP instead (needs a host that allows ports 465/587). Leave both empty in development: emails then appear at http://localhost:5173/dev/mailbox
# Works with any SMTP provider, e.g. Resend (smtp.resend.com), Brevo (smtp-relay.brevo.com), Postmark, Gmail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kindhands <hello@your-domain.com>

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10
REMINDER_INTERVAL_MS=300000
